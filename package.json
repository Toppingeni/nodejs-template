{
    "name": "nodejs-template",
    "version": "1.0.0",
    "description": "Backend template — Express + TSOA + Oracle 11g",
    "private": true,
    "packageManager": "pnpm@10.15.0",
    "scripts": {
        "dev": "tsx --watch --watch-path ./server server/start.ts",
        "build": "pnpm tsoa:gen && vite build --config server/vite.config.server.ts",
        "start": "node dist/server/node-build.mjs",
        "tsoa:spec": "tsoa spec -c server/tsoa.json",
        "tsoa:routes": "tsoa routes -c server/tsoa.json",
        "tsoa:gen": "pnpm tsoa:spec && pnpm tsoa:routes",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "test": "vitest run --root server",
        "test:watch": "vitest --root server",
        "test:coverage": "vitest run --root server --coverage",
        "mapsql": "tsx server/scripts/mapsql.ts",
        "downsql": "tsx server/scripts/mapsql.ts --download",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix --no-warn-ignored",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@tsoa/runtime": "7.0.0-alpha.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "keys-converter": "^3.0.4",
        "node-vault-client": "^1.0.2",
        "oracledb": "^6.8.0",
        "sequelize": "^6.37.7",
        "sequelize-oracle": "^3.3.2-0.0",
        "swagger-ui-express": "^5.0.1",
        "tns": "^0.2.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.1",
        "@types/express-rate-limit": "^5.1.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.14.0",
        "@types/node-vault-client": "^1.0.1",
        "@types/oracledb": "^6.5.4",
        "@types/sequelize": "^4.28.20",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "@vitest/coverage-v8": "^4.1.2",
        "eslint": "^10.2.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "tsoa": "^7.0.0-alpha.0",
        "tsx": "^4.21.0",
        "typescript": "^5.8.3",
        "vite": "^6.4.1",
        "vitest": "^4.1.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "oracledb"
        ]
    }
}

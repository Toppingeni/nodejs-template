{
    "entryFile": "server.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": ["controllers/**/*controller.ts", "controllers/**/*Controller.ts"],
    "spec": {
        "outputDirectory": "tsoa",
        "specVersion": 3,
        "basePath": "/api",
        "securityDefinitions": {
            "jwt": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "routes": {
        "routesDir": "tsoa",
        "basePath": "/api",
        "authenticationModule": "./middlewares/authentication"
    }
}

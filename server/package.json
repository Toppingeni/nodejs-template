{
    "name": "fullstack-template-server",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx --watch start.ts",
        "build": "vite build --config vite.config.server.ts",
        "start": "node ../dist/server/node-build.mjs",
        "tsoa:spec": "tsoa spec",
        "tsoa:routes": "tsoa routes",
        "tsoa:gen": "npm run tsoa:spec && npm run tsoa:routes",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "mapsql": "tsx scripts/mapsql.ts",
        "downsql": "tsx scripts/mapsql.ts --download"
    },
    "dependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "keys-converter": "^3.0.4",
        "node-vault-client": "^1.0.2",
        "oracledb": "^6.8.0",
        "sequelize": "^6.37.7",
        "sequelize-oracle": "^3.3.2-0.0",
        "swagger-ui-express": "^5.0.1",
        "tns": "^0.2.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.1",
        "@types/express-rate-limit": "^5.1.3",
        "@types/node": "^22.14.0",
        "@types/node-vault-client": "^1.0.1",
        "@types/oracledb": "^6.5.4",
        "@types/sequelize": "^4.28.20",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/coverage-v8": "^4.1.2",
        "tsoa": "^7.0.0-alpha.0",
        "tsx": "^4.19.0",
        "typescript": "^5.8.3",
        "vite": "^6.0.0",
        "vitest": "^4.1.2"
    }
}

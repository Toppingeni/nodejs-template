# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== Oracle Database =====
ORACLE_DB_NAME=ORCL
ORACLE_USER=KPDB
ORACLE_PWD=
ORACLE_CLIENT_PATH=
TNS_PATH=

# ===== Vault (optional) =====
VAULT_URL=http://192.168.55.25:8200
VAULT_USER=
VAULT_PWD=

# ===== Application =====
APP_ID=0
PING_MESSAGE=pong

# ===== Logging =====
ENABLE_LOGGING=true
# DEBUG | INFO | WARN | ERROR | FATAL — ERROR/FATAL ไม่เคยถูกปิดด้วยค่านี้
LOG_LEVEL=DEBUG
WS_LOG_SERVER_URL=
# ชื่อ service บน tracker dashboard — โปรเจกต์ที่ลอก template ต้องตั้งเอง
LOG_SERVICE_NAME=oppn-backend
# ไม่ตั้ง = เปิด console นอก production
LOG_CONSOLE=
# ไม่ตั้ง = เขียนไฟล์เฉพาะ production
LOG_TO_FILE=
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ===== SQLTab Dev Override =====
SQLTAB_DIR=server/sqltabs


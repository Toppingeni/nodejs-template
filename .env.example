# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== Oracle Database =====
ORACLE_DB_NAME=ORCL
ORACLE_USER=KPDB
ORACLE_PWD=
ORACLE_CLIENT_PATH=
TNS_PATH=

# ===== Vault (optional) =====
VAULT_URL=http://192.168.55.25:8200
VAULT_USER=
VAULT_PWD=

# ===== Application =====
APP_ID=0
PING_MESSAGE=pong

# ===== Logging =====
ENABLE_LOGGING=true
LOG_LEVEL=DEBUG
WS_LOG_SERVER_URL=

# ===== SQLTab Dev Override =====
SQLTAB_DIR=src/sqltabs

# ===== Client (VITE_ prefix) =====
VITE_API_URL=http://localhost:3000
VITE_API_AUTH_URL=http://localhost:3000
VITE_BYPASS_AUTH=true
VITE_PORT=8080
